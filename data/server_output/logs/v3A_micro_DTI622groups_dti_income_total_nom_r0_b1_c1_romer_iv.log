. ********************************************************************************
. * calculate log differences of dependent variable for each HH at horizons h=0,1,...,NN
. 
. * generate average
. tsset lnr year

Panel variable: lnr (unbalanced)
 Time variable: year, 1995 to 2015, but with gaps
         Delta: 1 unit

. 
. forval j = 0/$NN  {
  2.         qui gen ${dependent_var}_d`j' = (f`j'.debt_nom/f`j'.income_total_nom)*((f`j'.$dependent_var  - l1.$dependent_var )/(l1.income_total_nom))
  3.         }

. 
. 
. * generate control vars
. g control_1 = (l.debt_nom/l.income_total_nom)*((l1.$dependent_var - l2.$dependent_var )/abs(l2.income_total_nom))
(14,861,668 missing values generated)

. g control_2 = (l2.debt_nom/l2.income_total_nom)*((l2.$dependent_var - l3.$dependent_var )/abs(l3.income_total_nom))
(18,544,202 missing values generated)

. 
. cap drop balance

. gen balance = 1

. 
. if ${balance}==1 {
.         cap drop balance
.         gen balance = ${dependent_var}_d0 != . & ${dependent_var}_d1 != . & ${dependent_var}_d2 != . & ${dependent_var}_d3 != . & ${dependent_var}_d4 != . & ${dependent_var}_d5 != .
. }

.                                 
. ********************************************************************************
. * Local Projections
. 
. * calculate number of groups used
. qui su group, meanonly 

. local group_nb = r(max)         

.                 
. * make matrices ready
. matrix res = J(($NN+1)*`group_nb',1,0)

. matrix seRes = J(($NN+1)*`group_nb',1,0)

. matrix NObs = J(($NN+1)*`group_nb',1,0)         

.                                 
. forval kk=1/`group_nb' {
  2. preserve
  3. keep if group == `kk'
  4. 
. 
. forval j=0/$NN {
  5. 
. 
.         if "${shock_name}"=="market" {
  6.                 eststo: qui xtivreg2 ${dependent_var}_d`j' (d_ir_eoy = shock_l0) shock_l1 shock_l2 shock_l3 control_* $demogr_controls if group == `kk' & DTI_jan_1st != . & balance 
> == 1 & year >= 2001, fe dkraay($DK_lag)
  7.         }
  8.         else {
  9.                 eststo: qui xtivreg2 ${dependent_var}_d`j' (d_ir_eoy = shock_l0) shock_l1 shock_l2 shock_l3 control_* $demogr_controls if group == `kk' & DTI_jan_1st != . & balance 
> == 1, fe dkraay($DK_lag)
 10.         }
 11.         
.         di as text "horizon `j': first-stage F (Kleibergen-Paap rk Wald) = " %9.2f e(widstat) "   N = " e(N)
 12. 
.         *store results
.         local jnum = `j'+1
 13.         matrix beta = e(b)
 14.         matrix res[(`kk'-1)*($NN+1)+`jnum',1] = beta[1,1]
 15.         mat VV = e(V)
 16.         matrix seRes[(`kk'-1)*($NN+1)+`jnum',1] = sqrt(VV[1,1])
 17.         matrix NObs[(`kk'-1)*($NN+1)+`jnum',1] = e(N)
 18.         
.         }
 19.         
.         * show estimates
.         if $show_output==1 {
 20.         esttab, se compress replace
 21.         }
 22.         eststo clear
 23. 
.         restore
 24. }
