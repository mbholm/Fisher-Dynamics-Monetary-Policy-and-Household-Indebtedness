. *gen sample = ${dependent_var}_d0 != . & ${dependent_var}_d1 != . & ${dependent_var}_d2 != . & ${dependent_var}_d3 != . & ${dependent_var}_d4 != . & ${dependent_var}_d5 != .
.                                 
. forval kk=1/`group_nb' {
  2. preserve
  3. keep if group == `kk'
  4. 
. forval j=0/$NN {
  5. 
. 
. 
