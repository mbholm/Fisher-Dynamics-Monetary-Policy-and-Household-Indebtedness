. matrix NObs = J($NN+1,1,0)

. 
. forval j=0/$NN {
  2.         
.         if "${shock_name}"=="market" {
  3.                 eststo: qui xtivreg2 ${dependent_var}_d`j' (d_ir_eoy = shock_l0_neg) shock_l1 shock_l2 shock_l3 control_* $demogr_controls if DTI_jan_1st != . & balance == 1 & year 
> >= 2001, fe dkraay($DK_lag)
  4.         }
  5.         else {
  6.                 eststo: qui xtivreg2 ${dependent_var}_d`j' (d_ir_eoy = shock_l0_neg) shock_l1 shock_l2 shock_l3 control_* $demogr_controls if DTI_jan_1st != . & balance == 1, fe dkr
> aay($DK_lag)
  7.         }
  8.         
.         
.         di as text "horizon `j': first-stage F (Kleibergen-Paap rk Wald) = " %9.2f e(widstat) "   N = " e(N)
  9. 
.         *store results
.         local jnum = `j'+1
 10.         matrix beta = e(b)
 11.         matrix res[`jnum',1] = beta[1,1]
 12.         mat VV = e(V)
 13.         matrix seRes[`jnum',1] = sqrt(VV[1,1])
 14.         matrix NObs[`jnum',1] = e(N)
 15.         
. }
