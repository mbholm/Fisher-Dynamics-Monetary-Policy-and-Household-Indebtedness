. g control_2 = ((l2.$dependent_var - l3.$dependent_var )/abs(l3.income_total_nom))
(18,544,202 missing values generated)

. 
. cap drop balance

. gen balance = 1

. 
. if ${balance}==1 {
.         cap drop balance
.         gen balance = ${dependent_var}_d0 != . & ${dependent_var}_d1 != . & ${dependent_var}_d2 != . & ${dependent_var}_d3 != . & ${dependent_var}_d4 != . & ${dependent_var}_d5 != .
. }

