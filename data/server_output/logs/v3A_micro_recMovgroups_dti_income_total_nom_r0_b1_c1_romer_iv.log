. ********************************************************************************
. * Local Projections
. 
. * calculate number of groups used
. qui su group, meanonly 

. local group_nb = r(max)         

.                 
. * make matrices ready
. matrix res = J(($NN+1)*`group_nb',1,0)

. matrix seRes = J(($NN+1)*`group_nb',1,0)

. matrix NObs = J(($NN+1)*`group_nb',1,0)         

.                                 
. forval kk=1/`group_nb' {
  2. preserve
  3. keep if group == `kk'
  4. 
. 
. forval j=0/$NN {
  5. 
. 
.         if "${shock_name}"=="market" {
  6.                 eststo: qui xtivreg2 ${dependent_var}_d`j' (d_ir_eoy = shock_l0) shock_l1 shock_l2 shock_l3 control_* $demogr_controls if group == `kk' & DTI_jan_1st != . & balance == 1 & year >= 2001, fe dkraay
> ($DK_lag)
  7.         }
  8.         else {
  9.                 eststo: qui xtivreg2 ${dependent_var}_d`j' (d_ir_eoy = shock_l0) shock_l1 shock_l2 shock_l3 control_* $demogr_controls if group == `kk' & DTI_jan_1st != . & balance == 1, fe dkraay($DK_lag)
 10.         }
 11.         
.         di as text "horizon `j': first-stage F (Kleibergen-Paap rk Wald) = " %9.2f e(widstat) "   N = " e(N)
 12. 
.         *store results
.         local jnum = `j'+1
 13.         matrix beta = e(b)
 14.         matrix res[(`kk'-1)*($NN+1)+`jnum',1] = beta[1,1]
 15.         mat VV = e(V)
 16.         matrix seRes[(`kk'-1)*($NN+1)+`jnum',1] = sqrt(VV[1,1])
 17.         matrix NObs[(`kk'-1)*($NN+1)+`jnum',1] = e(N)
 18.         
.         }
 19.         
.         * show estimates
.         if $show_output==1 {
 20.         esttab, se compress replace
 21.         }
 22.         eststo clear
 23. 
.         restore
 24. }
