. g control_2 = (l2.debt_nom/l2.income_total_nom)*((l2.$dependent_var - l3.$dependent_var )/abs(l3.income_total_nom))
(18,544,202 missing values generated)

. 
. cap drop balance

. gen balance = 1

. 
. if ${balance}==1 {
.         cap drop balance
