. * means by column
. 
. local conditions `" "DTI_quintile_byyear != ." "DTI_quintile_byyear == 1" "DTI_quintile_byyear == 2" "DTI_quintile_byyear == 3" "DTI_quintile_byyear == 4" "DTI_quintile_byyear == 5" "dumUNE
> MP2 == 0" "dumUNEMP2 == 1" "dumUNEMP3 == 0" "dumUNEMP3 == 1" "move_dum == 0" "move_dum == 1" "'

. 
. local rowvars age GS HS CO deb_inc debt_a income_total income_x_nintinc income_intexp income_intinc ddeb_inc prim_def Fisher_effect i_t g_t pi_t pred_unemp2 move_pct

. 
. * one row per variable
. local first = 1

. foreach x of local rowvars {
  2.         matrix row = J(1,12,.)
  3.         local cc = 0
  4.         foreach cond of local conditions {
  5.                 local cc = `cc' + 1
  6.                 qui su `x' if `cond'
  7.                 matrix row[1,`cc'] = r(mean)
  8.         }
  9.         if `first' == 1 matrix output = row
 10.         else            matrix output = output\row
 11.         local first = 0
 12. }

. 
. * last row: number of observations
. matrix row = J(1,12,.)

. local cc = 0

. foreach cond of local conditions {
  2.         local cc = `cc' + 1
  3.         qui count if age != . & `cond'
  4.         matrix row[1,`cc'] = r(N)
  5. }

. matrix output = output\row

. 
. matrix rownames output = `rowvars' N

. matrix colnames output = All DTI1 DTI2 DTI3 DTI4 DTI5 UN0 UN1 UN00 UN11 MOV0 MOV1

. 
. capture drop N

. gen byte N = .
(48,609,706 missing values generated)

. label var N "Observations"

. 
